// strict を掛けるディレクトリだけを include に並べる（全体の tsconfig.json は strict: false のまま）。
// include から import される外のファイルも strict で検査される。
// src/server は 2026-11-21 に足した：src/server/app.ts から import される src/generic/g02.ts の strictNullChecks の型エラー 1 件
// （包括の検査の段の点数が null になり得る）を、その群を検算の対象外に回す形で直したため
// 2026-11-21 に tests/ 以外のすべて（src・scripts・app・直下の設定）に広げた：src/connect/orca.ts の性別の null と scripts/gen-uke.ts の列の型を直したため。tests/ は残り 20 件
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "incremental": false
  },
  "include": ["next-env.d.ts", "src/**/*.ts", "scripts/**/*.ts", "app/**/*.ts", "app/**/*.tsx", "proxy.ts", "instrumentation.ts", "next.config.ts", "vitest.config.ts"]
}
