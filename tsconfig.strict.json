// strict を掛けるディレクトリだけを include に並べる（全体の tsconfig.json は strict: false のまま）。
// include から import される外のファイルも strict で検査される。
// src/server は入れていない：src/server/app.ts から import される src/generic/g02.ts に strictNullChecks の型エラーが 1 件ある
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "incremental": false
  },
  "include": ["next-env.d.ts", "src/engine/**/*.ts", "src/uke/**/*.ts"]
}
